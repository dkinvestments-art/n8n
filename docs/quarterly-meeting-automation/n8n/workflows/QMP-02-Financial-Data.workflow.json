      "position": [
        220,
        300
      ],
      "credentials": {
        "quickBooksOAuth2Api": {
          "id": "REPLACE_ASTUTE_QBO",
          "name": "Karen Astute Advisors QuickBooks"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
