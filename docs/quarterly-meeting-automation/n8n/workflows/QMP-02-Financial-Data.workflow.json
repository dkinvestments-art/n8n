      ],
      "credentials": {
        "quickBooksOAuth2Api": {
          "id": "REPLACE_ASTUTE_QBO",
          "name": "Karen Astute Advisors QuickBooks"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Input').first().json;\nreturn [{ json: { ...ctx, financials: {\n  pnl_ytd: $('QBO: P&L current YTD').first().json,\n  pnl_last_12mo: $('QBO: P&L last 12mo').first().json,\n  pnl_prior_12mo: $('QBO: P&L prior 12mo').first().json,\n  balance_sheet: $('QBO: Balance Sheet').first().json,\n} } }];\n"
      },
      "id": "Combine_financials",
      "name": "Combine financials",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    }
  ],
  "connections": {
    "Input": {
      "main": [
        [
          {
            "node": "QBO: P&L current YTD",
