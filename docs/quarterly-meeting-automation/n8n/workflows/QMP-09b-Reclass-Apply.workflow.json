  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Applies ONLY human-approved rows from the Reclassification Review tab to QBO (full-object update with the approved account), writes the audit log, and marks rows applied. Run manually or on a schedule after Karen approves rows."
  }
}