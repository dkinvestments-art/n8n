        "jsCode": "const events = $input.all().map(i => i.json).filter(e => String(e.summary ?? '').toLowerCase().includes('quarterly'));\nreturn [{ json: { events: events.map(e => ({ summary: e.summary, start: e.start?.dateTime ?? e.start?.date ?? '' })) } }];\n"
