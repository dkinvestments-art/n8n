    {
      "parameters": {
        "jsCode": "const events = $('Collect quarterly events').first().json.events ?? [];\nconst profiles = $('Read client profiles').all().map(i => i.json).filter(p => p.client_name);\nconst log = $('Read Run Log').all().map(i => i.json);\nfor (const e of events) {\n  const p = profiles.find(p => String(e.summary).toLowerCase().includes(String(p.client_name).toLowerCase()));\n  if (!p) continue;\n  const meetingDate = String(e.start).slice(0, 10);\n  const already = log.some(r => r.client_id === p.client_id && r.meeting_date === meetingDate);\n  if (already) continue;\n  return [{ json: { ...p, meeting_date: meetingDate, meeting_summary: e.summary, questionnaire: null } }];\n}\nreturn [];\n"
      },
