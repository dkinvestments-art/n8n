        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ASTUTE_GOOGLE",
          "name": "Karen Astute Advisors Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(i => ({ json: { proposed_at: i.json.proposed_at, client_id: i.json.client_id,\n  pattern: i.json.pattern, occurrences: i.json.occurrences, status: i.json.status } }));\n"
      },
      "id": "To_pattern_rows",
      "name": "To pattern rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        420
      ]
    },
    {
