      "id": "qbo_txn",
      "name": "QBO: recent transactions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "quickBooksOAuth2Api": {
          "id": "REPLACE_ASTUTE_QBO",
          "name": "Karen Astute Advisors QuickBooks"
        }
      }
